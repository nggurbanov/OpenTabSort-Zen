    "defaultValue": false
  },
  {
    "type": "dropdown",
    "label": "Rule matching priority \u2014 choose whether URL/domain matches or title matches are checked first",
    "property": "extensions.zen-auto-organize.match-mode",
    "defaultValue": "url-then-title",
    "options": [
      {
        "label": "URL only",
        "value": "url-only"
      },
      {
        "label": "Title only",
        "value": "title-only"
      },
      {
        "label": "URL then Title",
        "value": "url-then-title"
      },
      {
        "label": "Title then URL",
        "value": "title-then-url"
      }
    ]
  },
  {
    "type": "dropdown",
    "label": "Gradient style \u2014 choose how two-color group gradients are drawn",
