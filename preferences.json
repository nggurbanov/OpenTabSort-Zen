  {
    "type": "separator",
    "label": "AI Sorting"
  },
  {
    "type": "dropdown",
    "label": "AI engine",
    "property": "extensions.zen-auto-organize.ai-engine",
    "defaultValue": "off",
    "placeholder": false,
    "options": [
      {
        "label": "None",
        "value": "off"
      },
      {
        "label": "Local \u2014 Built-in model, limited capability",
        "value": "local"
      },
      {
        "label": "Ollama \u2014 Stronger model, requires Ollama running locally",
        "value": "ollama"
      },
      {
        "label": "OpenAI-compatible \u2014 Remote or self-hosted /v1/chat/completions",
        "value": "openai"
      },
      {
        "label": "Gemini \u2014 Google AI Studio generateContent",
        "value": "gemini"
      },
      {
        "label": "Custom \u2014 OpenAI or Ollama-compatible endpoint",
        "value": "custom"
      },
      {
        "label": "Decision models \u2014 Jev and compatible APIs",
        "value": "jev"
      }
    ]
  },
  {
    "property": "extensions.zen-auto-organize.ai-review-before-apply",
    "label": "Review groups before applying",
    "type": "checkbox",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Allow sending tab titles, URLs, and optional page snippets to the selected provider",
    "property": "extensions.zen-auto-organize.ai-provider-consent",
    "defaultValue": false
  },
  {
    "type": "dropdown",
    "label": "Sorting mode",
    "property": "extensions.zen-auto-organize.ai-sort-mode",
    "defaultValue": "rules-first",
    "options": [
      {
        "label": "Rules + AI \u2014 Match rules, then classify leftovers",
        "value": "rules-first"
      },
      {
        "label": "Full AI \u2014 Regroup all eligible tabs without saving rules",
        "value": "full-ai"
      }
    ]
  },
  {
    "type": "dropdown",
    "label": "AI title learning \u2014 propose reviewed T chips from tab titles (simple) and/or page content (complex)",
    "property": "extensions.zen-auto-organize.ai-title-learning",
    "defaultValue": "off",
    "placeholder": false,
    "options": [
      {
        "label": "None",
        "value": "off"
      },
      {
        "label": "Review and Save (Simple)",
        "value": "review-save-simple"
      },
      {
        "label": "Review and Save (Complex)",
        "value": "review-save-complex"
      }
    ]
  },
  {
    "type": "dropdown",
    "label": "Existing AI matches \u2014 choose whether matched tabs update saved rules",
    "property": "extensions.zen-auto-organize.ai-existing-behavior",
    "defaultValue": "always-add",
    "options": [
      {
        "label": "Move + Save Domain \u2014 Move the tab and add its domain to the matched rule",
        "value": "always-add"
      },
      {
        "label": "Move Once \u2014 Move the tab now; do not update saved rules",
        "value": "transient"
      }
    ]
  },
  {
    "type": "dropdown",
    "label": "New AI groups \u2014 choose whether new groups become saved rules",
    "property": "extensions.zen-auto-organize.ai-new-group-behavior",
    "defaultValue": "auto-add",
    "options": [
      {
        "label": "Preview + Save Rule \u2014 Review first; kept groups become saved rules",
        "value": "auto-add"
      },
      {
        "label": "Group Once \u2014 Create groups now; do not save rules",
        "value": "transient"
      },
      {
        "label": "Zen Edit Prompt \u2014 Create groups, then open Zen's rename/color dialog",
        "value": "prompt"
      },
      {
        "label": "Fresh Rebuild \u2014 Ignore current rules and regroup all tabs from scratch",
        "value": "fresh-categories"
      },
      {
        "label": "Preview Only \u2014 Review/re-assign first; apply groups without saving rules",
        "value": "identify-only"
      }
    ]
  },
  {
    "type": "string",
    "label": "Ollama host",
    "property": "extensions.zen-auto-organize.ai-ollama-host",
    "defaultValue": "http://localhost:11434"
