    "options": [
      {
        "label": "Left to right",
        "value": "left-right"
      },
      {
        "label": "Right to left",
        "value": "right-left"
      },
      {
        "label": "Top to bottom",
        "value": "top-bottom"
      },
      {
        "label": "Bottom to top",
        "value": "bottom-top"
