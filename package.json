{
  "name": "opentabsort-zen",
  "version": "2.0.3",
  "private": true,
  "type": "module",
  "description": "One-click AI grouping for crowded Zen workspaces, with Stop, Undo and optional review.",
  "scripts": {
    "test": "node --test",
    "validate": "node scripts/validate.mjs",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "validate:preferences": "node scripts/validate-preferences.mjs",
    "validate:security": "node scripts/validate-security.mjs",
    "compare": "node scripts/compare-neurosort-advantages.mjs",
    "e2e:zen": "node scripts/e2e-zen.mjs",
    "check": "npm run validate && npm test && npm run compare",
    "e2e:jev": "node scripts/e2e-jev.mjs",
    "benchmark": "node scripts/benchmark-runtime.mjs",
    "e2e:operations": "node scripts/e2e-overhaul.mjs",
    "e2e:recovery": "node scripts/e2e-output-recovery.mjs",
    "e2e:settings": "node scripts/e2e-settings.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
